# --- Server Configuration ---
PORT=8080
SPRING_PROFILES_ACTIVE=default

# --- Abios Atlas API ---
ABIOS_API_KEY=

# --- Caching & Data ---
# Modes: memory | redis
CACHE_MODE=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Rate Limiting (Public API) ---
APP_LIVE_CLIENT_RATE_LIMIT_PER_MINUTE=120
APP_LIVE_CLIENT_BURST_CAPACITY=120

# --- Debug logging  ---
ABIOS_LOG_UPSTREAM_PAYLOAD=true
