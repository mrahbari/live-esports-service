# --- Server Configuration ---
PORT=8080
SPRING_PROFILES_ACTIVE=default

# --- Abios Atlas API ---
ABIOS_API_KEY=

# --- Caching & Data ---
# Modes: memory | redis
CACHE_MODE=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Ingestion Configuration ---
# Time-window in days to limit the dataset (default 25)
INGESTION_SERIES_WINDOW_DAYS=2

# --- Polling Configuration ---
APP_POLLING_LIVE_INTERVAL_MS=3000
APP_POLLING_UPCOMING_INTERVAL_MS=15000

# --- Rate Limiting (Public API) ---
APP_LIVE_CLIENT_RATE_LIMIT_PER_MINUTE=120
APP_LIVE_CLIENT_BURST_CAPACITY=120

# --- Debug logging  ---
LOG_UPSTREAM_PAYLOAD=true
# V1 (cache-backed stream path) log level — DEBUG | INFO | WARN | OFF
LOG_V1_LEVEL=INFO
# V2 (db-backed polling/ingestion path) log level — DEBUG | INFO | WARN | OFF
LOG_V2_LEVEL=INFO
