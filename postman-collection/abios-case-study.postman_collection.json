    {
      "name": "Rate limiting",
      "item": [
        {
          "name": "GET /v1/series/live (X-Forwarded-For = testClientIp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 429) {",
                  "    pm.test(\"Retry-After present\", () => pm.expect(pm.response.headers.get(\"Retry-After\")).to.exist);",
                  "} else {",
                  "    pm.test(\"Status 200 when under limit\", () => pm.response.to.have.status(200));",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Forwarded-For",
                "value": "{{testClientIp}}",
                "description": "Uses a separate token bucket from your default client IP.",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/series/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "series",
                "live"
              ]
            }
          },
          "response": []
        }
      ],
      "description": "`IpRateLimitFilter` keys buckets by client IP (`X-Forwarded-For` first hop, else socket address).\n\nSet collection variable `testClientIp` to simulate another client without changing your machine.\n\nTo see HTTP 429 with `Retry-After`, run **GET /series/live** repeatedly (Collection Runner, delay 0 ms) until the bucket is empty."
    },
    {
      "name": "Pagination",
      "item": [
        {
          "name": "GET /v1/series/live — page 1 (take=1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Page 1: skip=0, take=1\", () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.meta.skip).to.eql(0);",
                  "    pm.expect(j.meta.take).to.eql(1);",
                  "    pm.expect(j.items.length).to.be.at.most(1);",
                  "    pm.expect(j.meta.count).to.eql(j.items.length);",
                  "    pm.expect(j.meta.total).to.be.a('number');",
                  "    // store total for cross-request assertions",
                  "    pm.collectionVariables.set(\"_paginationTotal\", j.meta.total);",
                  "    pm.collectionVariables.set(\"_paginationHasMore\", j.meta.hasMore);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/series/live?skip=0&take=1",
              "host": [
