        {
          "name": "Fields + pagination combined",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Pagination meta respected\", () => {",
                  "    const m = pm.response.json().meta;",
                  "    pm.expect(m.skip).to.eql(0);",
                  "    pm.expect(m.take).to.eql(5);",
                  "    pm.expect(m.count).to.eql(pm.response.json().items.length);",
                  "});",
                  "pm.test(\"Sparse fields applied within page\", () => {",
                  "    const items = pm.response.json().items;",
                  "    if (items.length === 0) { return; }",
                  "    pm.expect(items[0]).to.have.property(\"nickname\");",
