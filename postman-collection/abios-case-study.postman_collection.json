                {
                  "key": "skip",
                  "value": "0"
                },
                {
                  "key": "take",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "description": "Demonstrates client-side pagination over the in-memory snapshot.\n\nAll live endpoints accept `skip` (0-based offset) and `take` (page size). Omitting both returns the full list — backwards compatible.\n\nPagination is applied in-memory after cache warm; zero upstream calls are made per page request."
    },
