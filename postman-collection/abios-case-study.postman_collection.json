    {
      "name": "Abios Atlas Direct (Issues & Blockers)",
      "item": [
        {
          "name": "1. Thin Payloads (Missing Names)",
          "request": {
            "method": "GET",
            "header": [{"key": "{{abiosAuthHeader2}}", "value": "{{abiosApiKey}}", "description": "{{abiosAuthValue}}", "type": "text"}],
            "url": {
              "raw": "{{abiosBaseUrl2}}/v3/series?filter=lifecycle<={live,ongoing}",
              "host": ["{{abiosBaseUrl2}}"],
              "path": ["v3", "series"],
              "query": [{"key": "filter", "value": "lifecycle<={live,ongoing}"}]
            },
            "description": "Demonstrates that the standard `/series` endpoint returns `roster_id` but NO names for teams or players.\n\n**Blocker:** Without enrichment, the UI would show empty strings or raw IDs only."
          },
          "response": []
        },
        {
          "name": "2. Ignored Deep Includes (Sandbox Blocker)",
          "request": {
            "method": "GET",
            "header": [{"key": "{{abiosAuthHeader2}}", "value": "{{abiosApiKey}}", "type": "text"}],
            "url": {
              "raw": "{{abiosBaseUrl2}}/v3/series?filter=lifecycle<={live,ongoing}&include=participants.roster.team.name,participants.roster.players.player.nick",
              "host": ["{{abiosBaseUrl2}}"],
              "path": ["v3", "series"],
              "query": [
                {"key": "filter",  "value": "lifecycle<={live,ongoing}"},
                {"key": "include", "value": "participants.roster.team.name,participants.roster.players.player.nick"}
              ]
            },
            "description": "Attempting to use `include` to solve the N+1 problem.\n\n**Blocker:** In the Sandbox tier, these deep includes are often ignored, still returning thin payloads. This forced us to implement the 'Enrichment' strategy."
          },
          "response": []
        },
        {
          "name": "3. Bulk Fetching Limitation (Ignored Filters)",
          "request": {
            "method": "GET",
            "header": [{"key": "{{abiosAuthHeader2}}", "value": "{{abiosApiKey}}", "type": "text"}],
            "url": {
              "raw": "{{abiosBaseUrl2}}/v3/rosters?id=123,456,789",
              "host": ["{{abiosBaseUrl2}}"],
              "path": ["v3", "rosters"],
              "query": [{"key": "id", "value": "123,456,789", "description": "Example IDs"}]
            },
            "description": "Attempting to fetch multiple rosters in one request.\n\n**Blocker:** Sandbox frequently ignores the `id` CSV list and returns a default page of data, making bulk hydration unreliable."
          },
          "response": []
        },
        {
          "name": "4. Rate Limit (429) Proof",
          "request": {
            "method": "GET",
            "header": [{"key": "{{abiosAuthHeader2}}", "value": "{{abiosApiKey}}", "type": "text"}],
            "url": {
              "raw": "{{abiosBaseUrl2}}/v3/rosters/148669",
              "host": ["{{abiosBaseUrl2}}"],
              "path": ["v3", "rosters", "148669"]
            },
            "description": "Run this request rapidly (e.g., using the Collection Runner with 100 iterations and 0ms delay).\n\n**Blocker:** Direct Abios Sandbox access is strictly limited. Parallel enrichment would crash the sync process, requiring our throttled sequential approach."
          },
          "response": []
        }
      ],
      "description": "Direct calls to the Abios Atlas V3 API to demonstrate the technical blockers identified in `ABIOS-INTEGRATION-FIXES.md`.\n\n**Note:** These require a valid `abiosApiKey` variable to be set in the collection or environment."
    }
