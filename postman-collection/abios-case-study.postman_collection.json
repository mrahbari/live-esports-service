      "description": "Public GET endpoints protected by per-IP rate limiting and request ID propagation.\n\nAll three endpoints share the same query params:\n- `skip` / `take` — pagination\n- `forceRefresh` — bypass cache\n- `fields` — sparse fieldsets (enable the disabled param to try it)"
    },
    {
      "name": "Sparse fieldsets",
      "item": [
        {
          "name": "Players — minimal (nickname + role only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"meta is always fully present\", () => {",
                  "    const m = pm.response.json().meta;",
                  "    pm.expect(m).to.have.property(\"fetchedAt\");",
                  "    pm.expect(m).to.have.property(\"count\");",
                  "    pm.expect(m).to.have.property(\"total\");",
                  "    pm.expect(m).to.have.property(\"hasMore\");",
                  "});",
                  "pm.test(\"items contain only requested fields\", () => {",
                  "    const items = pm.response.json().items;",
                  "    if (items.length === 0) { return; }",
                  "    const item = items[0];",
                  "    pm.expect(item).to.have.property(\"nickname\");",
                  "    pm.expect(item).to.have.property(\"role\");",
                  "    pm.expect(item).to.not.have.property(\"playerId\");",
                  "    pm.expect(item).to.not.have.property(\"firstName\");",
                  "    pm.expect(item).to.not.have.property(\"lastName\");",
                  "    pm.expect(item).to.not.have.property(\"teamId\");",
                  "    pm.expect(item).to.not.have.property(\"teamName\");",
                  "    pm.expect(item).to.not.have.property(\"seriesIds\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json", "type": "text"}],
            "url": {
              "raw": "{{baseUrl}}/v1/players/live?fields=nickname,role",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "players", "live"],
              "query": [{"key": "fields", "value": "nickname,role"}]
            },
            "description": "Returns only `nickname` and `role` per player. Confirms unrequested fields are absent and `meta` is always complete."
          },
          "response": []
