        {
          "name": "GET /v1/series/live (with X-Request-Id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response echoes X-Request-Id\", () => {",
                  "    const sent = pm.request.headers.get(\"X-Request-Id\");",
                  "    const echo = pm.response.headers.get(\"X-Request-Id\");",
                  "    pm.expect(echo).to.eql(sent);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {"key": "Accept",       "value": "application/json", "type": "text"},
              {"key": "X-Request-Id", "value": "{{$guid}}", "description": "Optional; server generates one if omitted. Response includes same header.", "type": "text"}
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/series/live",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "series", "live"]
            },
            "description": "Verifies `X-Request-Id` echo — sent header must be returned in the response."
          },
          "response": []
        }
